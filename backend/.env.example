# ==========================================
# KrishiVaani Environment Configuration File
# ==========================================

# ------------------------------------------
# 1. Database Settings (MongoDB)
# ------------------------------------------
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=krishivaani_db

# ------------------------------------------
# 2. Weather API (OpenWeatherMap / IMD)
# ------------------------------------------
# Get your free key at https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# ------------------------------------------
# 3. LLM AI Agent Keys (LangChain)
# ------------------------------------------
# Provide whichever API key you have:
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------
# 4. Sarvam AI Voice, STT, TTS & Translation
# ------------------------------------------
# Multilingual Indian AI: Translation (mayura:v1), STT (saaras:v1), TTS (bulbul:v1)
# Get your API key at https://www.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here

# ------------------------------------------
# 5. Satellite Earth Engine (Sentinel-2)
# ------------------------------------------
EE_PROJECT=your_google_earth_engine_project_id_here

